{
    "name": "darory/whatsapp",
    "description": "PHP and Laravel client for the Darory WhatsApp API: send messages and files, check numbers, manage sessions and receive webhooks.",
    "keywords": ["whatsapp", "darory", "whatsapp-api", "laravel", "notifications", "webhook"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://darory.com",
    "authors": [
        {
            "name": "Darory",
            "homepage": "https://darory.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "illuminate/support": "Laravel integration: config, facade, notification channel, webhook route and events (Laravel 10, 11 or 12)."
    },
    "autoload": {
        "psr-4": {
            "Darory\\WhatsApp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darory\\WhatsApp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Darory\\WhatsApp\\Laravel\\WhatsAppServiceProvider"
            ],
            "aliases": {
                "WhatsApp": "Darory\\WhatsApp\\Laravel\\Facades\\WhatsApp"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
